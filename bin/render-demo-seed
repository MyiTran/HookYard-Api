#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "${ADMIN_DEMO_DRY_RUN:-0}" != "1" ]]; then
  for required_env in HOOKYARD_DEMO_SEED DEMO_ADMIN_PASSWORD ADMIN_DEMO_CONFIRM_DATABASE \
    DEMO_DELIVERY_ATTEMPTS_TARGET; do
    if [[ -z "${!required_env:-}" ]]; then
      echo "${required_env} is required for a write run" >&2
      exit 64
    fi
  done
fi

exec bundle exec rake admin:demo:seed
